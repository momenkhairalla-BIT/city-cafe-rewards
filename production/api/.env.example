# Aida Cafe API — environment template
# Copy to .env and fill locally. NEVER commit a real .env file.
# All values below are placeholders only.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Local or disposable Postgres only for development.
# Do NOT paste production Neon credentials into Git or chat logs.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Strong random secret in any shared/deployed environment
JWT_SECRET=replace-with-long-random-string

# development | production
NODE_ENV=development

# HTTP listen port (default 3001)
PORT=3011

# ---------------------------------------------------------------------------
# CORS / CSRF (comma-separated origins for browser clients)
# ---------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173,http://localhost:3011
# Optional extra CSRF allow-list (defaults include localhost:5173 / :3001)
# CSRF_ALLOWED_ORIGINS=http://localhost:5173

# Dev-only: skip CSRF Origin check (never enable in production)
ALLOW_CSRF_BYPASS=0

# ---------------------------------------------------------------------------
# Feature flags — keep DISABLED for production-like environments
# ---------------------------------------------------------------------------
# Server-authoritative POS sales (Phase 3A). Enable only on authorised temp DB.
ENABLE_POS_SALES=0

# Deprecated legacy employee Bearer login for index.html dual-run (remove Phase 5)
ENABLE_LEGACY_EMPLOYEE_LOGIN=0

# ---------------------------------------------------------------------------
# Employee session cookies
# ---------------------------------------------------------------------------
EMPLOYEE_SESSION_COOKIE=aida_employee_session
EMPLOYEE_SESSION_IDLE_MS=1800000
EMPLOYEE_SESSION_ABSOLUTE_MS=43200000
# Force Secure cookie flag outside NODE_ENV=production if needed
EMPLOYEE_COOKIE_SECURE=0

# ---------------------------------------------------------------------------
# Terminal cookies
# ---------------------------------------------------------------------------
TERMINAL_COOKIE_NAME=aida_terminal
TERMINAL_COOKIE_MAX_AGE_MS=15552000000
TERMINAL_COOKIE_SECURE=0
# In production, __Host- prefix is used unless explicitly disabled:
# TERMINAL_COOKIE_HOST_PREFIX=0
TERMINAL_ENROL_TTL_MS=900000

# ---------------------------------------------------------------------------
# Auth / tokens
# ---------------------------------------------------------------------------
JWT_EXPIRES_IN=7d
JWT_LEGACY_EMPLOYEE_EXPIRES_IN=2h
# Optional pepper for credential lookup hashes (falls back to JWT_SECRET)
# CREDENTIAL_LOOKUP_PEPPER=

# ---------------------------------------------------------------------------
# Rate limits (raised automatically helpful defaults in non-production)
# ---------------------------------------------------------------------------
LOGIN_RATE_LIMIT_MAX=100
PIN_RATE_LIMIT_MAX=100
ENROL_RATE_LIMIT_MAX=100

# ---------------------------------------------------------------------------
# Disposable migration gates (scripts only — never point at production)
# ---------------------------------------------------------------------------
# ALLOW_DISPOSABLE_MIGRATE=1
# DISPOSABLE_DATABASE_URL=postgresql://USER:PASSWORD@TEMP_HOST/neondb?sslmode=require
# EXPECTED_DISPOSABLE_HOST=ep-polished-wildflower-aoqhtu9r.c-2.ap-southeast-1.aws.neon.tech
# ALLOW_NEON_DISPOSABLE=1
# CONFIRM_DISPOSABLE_TARGET=1

# ---------------------------------------------------------------------------
# Integration test runners (optional)
# ---------------------------------------------------------------------------
# TEST_BASE_URL=http://localhost:3011
# TEST_ORIGIN=http://localhost:3011
# TEST_LEGACY_ENABLED=1
# ALLOW_TEST_MUTATIONS=1
# ALLOW_WRITE_TESTS=1

{
  "name": "city-cafe-api",
  "version": "1.0.0",
  "description": "Aida Cafe Rewards production API",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "setup-db": "node scripts/setup-db.js",
    "migrate-v2": "node scripts/migrate-v2.js",
    "migrate-v3": "node scripts/migrate-v3.js",
    "migrate-v4": "node scripts/migrate-v4.js",
    "migrate-v5": "node scripts/migrate-v5.js",
    "migrate-v6": "node scripts/migrate-v6.js",
    "migrate-v7": "node scripts/migrate-v7.js",
    "migrate:validate:disposable": "node scripts/validate-migrations-disposable.js",
    "migrate:validate:disposable:local": "node scripts/run-disposable-gate-embedded.js",
    "migrate:phase2a:temp": "node scripts/migrate-phase2a-temp.js",
    "migrate:phase3a:temp": "node scripts/migrate-phase3a-temp.js",
    "test:phase2a": "node --test scripts/test-phase2a.js",
    "test:phase3a": "node --test scripts/test-phase3a.js src/services/money.test.js",
    "test:money": "node --test src/services/money.test.js",
    "test:terminal-cookie": "node --test scripts/test-terminal-cookie.js",

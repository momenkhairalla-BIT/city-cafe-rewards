    "test:production": "node scripts/test-production.js",
    "test:production:live": "node scripts/run-production-live.js",
    "test:phase2": "node scripts/test-phase2.js",
    "test:phase3": "node scripts/test-phase3.js",
    "test:phase4": "node scripts/test-phase4.js",
    "test:phase5": "node scripts/test-phase5.js",
    "test:authz": "node --test src/authz/permissions.test.js src/middleware/rateLimit.test.js",

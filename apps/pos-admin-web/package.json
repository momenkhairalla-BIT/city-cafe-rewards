{
  "name": "pos-admin-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/assert-no-legacy-token.mjs",
    "typecheck": "tsc -b --pretty false",
